{
  "version": 1,
  "name": "laptop",
  "bindings": [
    { "action": "camera.pitch_up",          "key": "UP",             "mods": [] },
    { "action": "camera.pitch_down",         "key": "DOWN",           "mods": [] },
    { "action": "camera.yaw_left",           "key": "LEFT",           "mods": [] },
    { "action": "camera.yaw_right",          "key": "RIGHT",          "mods": [] },
    { "action": "camera.roll_left",          "key": "Q",              "mods": [] },
    { "action": "camera.roll_right",         "key": "E",              "mods": [] },
    { "action": "camera.zoom_in",            "key": "EQUAL",          "mods": [] },
    { "action": "camera.zoom_out",           "key": "MINUS",          "mods": [] },
    { "action": "camera.reset",              "key": "R",              "mods": [] },
    { "action": "camera.center",             "key": "C",              "mods": [] },
    { "action": "move.thrust_forward",       "key": "W",              "mods": [] },
    { "action": "move.thrust_backward",      "key": "S",              "mods": [] },
    { "action": "move.thrust_left",          "key": "A",              "mods": [] },
    { "action": "move.thrust_right",         "key": "D",              "mods": [] },
    { "action": "move.thrust_up",            "key": "SPACE",          "mods": [] },
    { "action": "move.thrust_down",          "key": "LEFT_CONTROL",   "mods": [] },
    { "action": "move.brake",                "key": "X",              "mods": [] },
    { "action": "move.drift_toggle",         "key": "Z",              "mods": [] },
    { "action": "sim.timescale_increase",    "key": "PERIOD",         "mods": ["SUPER", "SHIFT"] },
    { "action": "sim.timescale_decrease",    "key": "COMMA",          "mods": ["SUPER", "SHIFT"] },
    { "action": "sim.tick_speed_increase",   "key": "PERIOD",         "mods": ["ALT"] },
    { "action": "sim.tick_speed_decrease",   "key": "COMMA",          "mods": ["ALT"] },
    { "action": "sim.dataset_increase",      "key": "EQUAL",          "mods": ["ALT"] },
    { "action": "sim.dataset_decrease",      "key": "MINUS",          "mods": ["ALT"] },
    { "action": "sim.pause_toggle",          "key": "P",              "mods": [] },
    { "action": "sim.track_next",            "key": "T",              "mods": [] },
    { "action": "sim.track_stop",            "key": "ESCAPE",         "mods": [] },
    { "action": "hud.toggle",                "key": "H",              "mods": [] },
    { "action": "hud.client_list",           "key": "BACKSLASH",      "mods": [] },
    { "action": "ui.settings",               "key": "F1",             "mods": [] },
    { "action": "ui.fullscreen",             "key": "F11",            "mods": [] },
    { "action": "ui.system_selector",        "key": "S",              "mods": ["SUPER"] },
    { "action": "ui.label_cycle",            "key": "L",              "mods": ["ALT"] },
    { "action": "ui.infra_cycle",            "key": "I",              "mods": [] },
    { "action": "ui.mouse_mode_toggle",      "key": "M",              "mods": ["ALT"] },
    { "action": "ui.quit",                   "key": "Q",              "mods": ["ALT"] },
    { "action": "ui.record_toggle",          "key": "R",              "mods": ["ALT"] },
    { "action": "ui.record_pause",           "key": "R",              "mods": ["ALT", "SHIFT"] },
    { "action": "nav.child_next",            "key": "F",              "mods": [] },
    { "action": "nav.parent",                "key": "B",              "mods": [] },
    { "action": "nav.sibling_next",          "key": "TAB",            "mods": [] },
    { "action": "nav.sibling_prev",          "key": "TAB",            "mods": ["SHIFT"] },
    { "action": "nav.jump",                  "key": "J",              "mods": [] },
    { "action": "repl.open",                 "key": "GRAVE",          "mods": [] },
    { "action": "repl.close",                "key": "ESCAPE",         "mods": [] },
    { "action": "repl.history_prev",         "key": "UP",             "mods": [] },
    { "action": "repl.history_next",         "key": "DOWN",           "mods": [] }
  ]
}
