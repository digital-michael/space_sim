{
  "window": {
    "width": 774,
    "height": 575,
    "fullscreen": true,
    "resizable": true
  },
  "render": {
    "mode": "native",
    "width": 0,
    "height": 0
  },
  "performance": {
    "frustum_culling": true,
    "lod_enabled": true,
    "instanced_rendering": true,
    "spatial_partition": true,
    "point_rendering": false,
    "importance_threshold": 0,
    "use_in_place_swap": true
  }
}
